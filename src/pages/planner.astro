---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
	<head>
		<BaseHead
			title="Free Desk Setup Planner: Plan Your Desk Layout | The Setup Vault"
			description="Plan your desk layout in two minutes. Answer four questions, drag your gear around a top-down desk, and get a fit check plus cable routing tips for your setup."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;800&display=swap" rel="stylesheet" />
		<style is:global>.dp{--bg:#0b1020;--panel:#131a30;--line:#25304f;--ink:#e8ecfa;--mute:#93a0c6;--acc:#3d5bff;--ok:#4ade80;--warn:#fbbf24;box-sizing:border-box}.dp *,.dp *::before,.dp *::after{box-sizing:border-box}.dp{margin:0;background:radial-gradient(900px 500px at 85% -10%,#1b2a6b55,transparent),var(--bg);color:var(--ink);font-family:"Bricolage Grotesque",system-ui,sans-serif;line-height:1.45;min-height:70dvh;-webkit-tap-highlight-color:transparent;font-size:16px}.dp .wrap{max-width:760px;margin:0 auto;padding:22px 16px 48px}.dp h1{font-size:clamp(30px,7vw,46px);line-height:1.05;margin:6px 0 10px;font-weight:800;letter-spacing:-.02em}.dp h2{font-size:18px;margin:0 0 10px;font-weight:600}.dp p{margin:0 0 14px;color:var(--mute);max-width:60ch}.dp .brand{font-weight:600;color:var(--mute);font-size:14px}.dp fieldset{border:0;padding:0;margin:0 0 20px}.dp legend{font-weight:600;margin-bottom:8px;padding:0}.dp .chips{display:flex;flex-wrap:wrap;gap:8px}.dp button,.dp a.btn{font:inherit;touch-action:manipulation;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}.dp .chip{background:var(--panel);color:var(--ink);border:1px solid var(--line);border-radius:12px;padding:10px 14px;cursor:pointer;text-align:left;transition:transform .12s,border-color .15s,background .15s}.dp .chip small{display:block;color:var(--mute);font-size:12px}.dp .chip.on{border-color:var(--acc);background:#1a2766}.dp .chip:active,.dp .btn:active{transform:scale(.97)}.dp .btn{display:inline-block;background:var(--acc);color:#fff;border:0;border-radius:12px;padding:12px 20px;font-weight:600;cursor:pointer;text-decoration:none;transition:transform .12s,background .15s}.dp .btn.alt{background:var(--panel);border:1px solid var(--line);color:var(--ink)}.dp .btn:disabled{opacity:.4;cursor:default}@media (hover:hover) and (pointer:fine){.dp .chip:hover{border-color:#4a5d9f}.dp .btn:hover{background:#5671ff}.dp .btn.alt:hover{background:#1b2444}}.dp .row{display:flex;flex-wrap:wrap;gap:10px;margin:14px 0}.dp #board{position:relative;isolation:isolate;width:100%;background:#182046;border:1px solid var(--line);border-radius:14px;touch-action:none;margin:6px 0;background-image:linear-gradient(#ffffff0a 1px,transparent 1px),linear-gradient(90deg,#ffffff0a 1px,transparent 1px);background-size:10% 20%}.dp .it{position:absolute;display:flex;align-items:center;justify-content:center;border-radius:6px;font-size:11px;font-weight:600;text-align:center;overflow:hidden;touch-action:none;cursor:grab;box-shadow:0 2px 0 #0006,0 6px 14px #0005;transition:transform .5s cubic-bezier(.2,.9,.3,1.2),opacity .4s,box-shadow .2s;outline-offset:2px}.dp .it.pre{opacity:0;transform:translateY(34px) scale(.85)}.dp .it.drag{transform:scale(1.05);box-shadow:0 14px 26px #0008;z-index:9;cursor:grabbing;transition:transform .12s,box-shadow .12s}.dp .it.sel{outline:2px solid #fff}.dp .it.tray{border:1.5px dashed #8fa0e8;box-shadow:none}.dp .it:focus-visible{outline:2px solid #fff}.dp #ck{list-style:none;margin:0;padding:0;display:grid;gap:6px}.dp #ck li{display:flex;gap:10px;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:9px 12px;font-size:14px}.dp #ck b{width:20px;text-align:center}.dp .g b{color:var(--ok)}.dp .w b{color:var(--warn)}.dp .card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px;margin:14px 0}.dp .card ul{margin:0;padding-left:20px;color:var(--ink)}.dp .card li{margin-bottom:6px}.dp #snap{width:100%;border-radius:12px;display:block;-webkit-touch-callout:default;user-select:auto}.dp .note{font-size:13px;color:var(--mute)}.dp #addp{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px;margin:8px 0 14px}.dp #addp input{font-size:16px;background:#0b1020;color:var(--ink);border:1px solid var(--line);border-radius:10px;padding:9px 10px;width:100%}.dp .cf{display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:8px;align-items:end;margin-top:12px}.dp .cf label{font-size:12px;color:var(--mute);display:block;margin-bottom:3px}.dp .it.pad{z-index:-1;box-shadow:none;border:1px solid #3a4a85}@media (max-width:520px){.dp .cf{grid-template-columns:1fr 1fr}.dp .cf .nm,.dp .cf button{grid-column:1/-1}}.dp [hidden]{display:none!important}@media (prefers-reduced-motion:reduce){.dp .it,.dp .it.pre,.dp .chip,.dp .btn{transition:none}.dp .it.pre{transform:none}}</style>
	</head>
	<body>
		<Header />
		<div class="dp"><div class="wrap">

<section id="intro">
<h1>Plan your desk in two minutes</h1>
<p>Answer four questions, then drag your gear around a top-down view of your desk. The fit check tells you what’s crowded before you move anything for real.</p>
<div id="qs"></div>
<button class="btn" id="go">Build my desk</button>
</section>

<section id="plan" hidden>
<h2 id="dim"></h2>
<p class="note">Drag items to move them. Tap one to select it, then rotate. Arrow keys nudge a focused item.</p>
<div id="board" aria-label="Desk layout"></div>
<div class="row">
<button class="btn alt" id="rot" disabled>Rotate selected</button>
<button class="btn alt" id="add">Add item</button>
<button class="btn alt" id="del" disabled>Remove selected</button>
<button class="btn alt" id="rst">Reset layout</button>
<button class="btn" id="fin">See my result</button>
</div>
<div id="addp" hidden>
<h2>Add something you own</h2>
<div class="chips" id="ex"></div>
<div class="cf"><div class="nm"><label for="cn">Or add your own</label><input id="cn" placeholder="Name, for example Router"></div>
<div><label for="cw">Width, cm</label><input id="cw" type="number" inputmode="decimal" min="2" max="150" value="20"></div>
<div><label for="ch">Depth, cm</label><input id="ch" type="number" inputmode="decimal" min="2" max="150" value="15"></div>
<button class="btn" id="ca">Add</button></div>
</div>
<h2 id="score"></h2>
<ul id="ck" aria-live="polite"></ul>
</section>

<section id="res" hidden>
<h1>Your layout</h1>
<img id="snap" alt="Your desk layout">
<p class="note">Press and hold the image to save it.</p>
<div class="card"><h2>Cable routing for your setup</h2><ul id="tips"></ul></div>
<div class="card"><h2>Setup checklist</h2><ul id="chk"></ul></div>
<div class="card">
<h2>Want the full routing plan?</h2>
<p>The Cable Guide and Desk Planner come together in the Setup Bundle.</p>
<div class="row" style="margin:0"><a class="btn" href="https://whop.com/the-setup-vault/products/the-setup-bundle/?utm_source=setupvault&utm_medium=planner" target="_blank" rel="noopener">Get the Setup Bundle, $29</a>
<a class="btn alt" href="https://whop.com/the-setup-vault/?utm_source=setupvault&utm_medium=planner" target="_blank" rel="noopener">Browse all guides</a></div>
</div>
<div class="row"><button class="btn alt" id="back">Edit layout</button></div>
</section>
</div></div>
		<Footer />
		<script is:inline>
const $=s=>document.querySelector(s);
const DESKS={"Compact":[100,50],"Standard":[140,70],"Wide":[160,80],"Extra wide":[200,90]};
const Q=[
{k:"desk",q:"How big is your desk?",o:Object.keys(DESKS).map(n=>[n,n,DESKS[n][0]+" × "+DESKS[n][1]+" cm"])},
{k:"mon",q:"How many monitors?",o:[[1,"1"],[2,"2"],[3,"3"]]},
{k:"pc",q:"What do you work on?",o:[["laptop","Laptop"],["tower","Desktop tower"]]},
{k:"cab",q:"About how many cables?",o:[[4,"Under 6"],[9,"6 to 12"],[16,"13 or more"]]}];
const A={desk:"Standard",mon:1,pc:"laptop",cab:9};
const C={mon:"#3d5bff",laptop:"#6d83ff",tower:"#2f3f8f",kb:"#34457f",mouse:"#34457f",lamp:"#fbbf24",tray:"transparent",extra:"#4f6fb0",pad:"#232d5a"};
const TXT={lamp:"#2a2000"};
let W,H,S,items=[],sel=null;

$("#qs").innerHTML="";
Q.forEach(q=>{const f=document.createElement("fieldset"),l=document.createElement("legend"),c=document.createElement("div");
l.textContent=q.q;c.className="chips";f.append(l,c);
q.o.forEach(o=>{const b=document.createElement("button");b.className="chip"+(A[q.k]==o[0]?" on":"");
b.innerHTML=o[1]+(o[2]?"<small>"+o[2]+"</small>":"");
b.onclick=()=>{A[q.k]=o[0];c.querySelectorAll(".chip").forEach(x=>x.classList.remove("on"));b.classList.add("on")};c.append(b)});
$("#qs").append(f)});

const mk=(id,n,t,w,h,x,y)=>({id,n,t,w,h,x,y,x0:x,y0:y,w0:w,h0:h});
function layout(){
[W,H]=DESKS[A.desk];items=[];const m=A.mon,mw=Math.min(54,(W-24)/m);
for(let i=0;i<m;i++)items.push(mk("m"+i,m>1?"Monitor "+(i+1):"Monitor","mon",mw,18,3+i*mw,3));
const kx=A.pc=="laptop"?40:(W-44)/2;
if(A.pc=="laptop")items.push(mk("pc","Laptop","laptop",34,24,3,H-27));
else items.push(mk("pc","Tower","tower",16,Math.min(42,H-22),W-19,H-Math.min(42,H-22)-3));
items.push(mk("kb","Keyboard","kb",44,14,kx,H-17),mk("ms","Mouse","mouse",7,12,kx+47,H-15),mk("lp","Lamp","lamp",12,12,W-15,3),
mk("tr","Cable tray","tray",Math.min(40,W-10),10,(W-Math.min(40,W-10))/2,0));
}
function build(){
layout();const b=$("#board");b.innerHTML="";sel=null;$("#rot").disabled=true;$("#del").disabled=true;
$("#dim").textContent=A.desk+" desk, "+W+" × "+H+" cm";
items.forEach(mkEl);
function mkEl(it,n){const b=$("#board"),e=document.createElement("div");e.className="it pre"+(it.t=="tray"?" tray":"");e.tabIndex=0;
e.textContent=it.n;e.style.background=C[it.t];e.style.color=TXT[it.t]||"#fff";it.el=e;b.append(e);
e.style.transitionDelay=n*70+"ms";
e.addEventListener("pointerdown",ev=>down(ev,it));e.addEventListener("pointermove",ev=>mv(ev,it));
e.addEventListener("pointerup",ev=>up(ev,it));e.addEventListener("pointercancel",ev=>up(ev,it));
e.addEventListener("keydown",ev=>{const d={ArrowLeft:[-1,0],ArrowRight:[1,0],ArrowUp:[0,-1],ArrowDown:[0,1]}[ev.key];
if(d){ev.preventDefault();const s=ev.shiftKey?5:1;put(it,it.x+d[0]*s,it.y+d[1]*s)}});
e.addEventListener("focus",()=>pick(it));}
render();
requestAnimationFrame(()=>requestAnimationFrame(()=>{items.forEach(i=>i.el.classList.remove("pre"));setTimeout(()=>items.forEach(i=>i.el.style.transitionDelay=""),1000)}));
}
function place(i){const e=i.el;e.style.width=i.w*S+"px";e.style.height=i.h*S+"px";e.style.left=i.x*S+"px";e.style.top=i.y*S+"px";e.style.fontSize=Math.max(9,Math.min(12,i.w*S/7))+"px"}
function render(){const b=$("#board");S=b.clientWidth/W;b.style.height=H*S+"px";items.forEach(place);checks()}
function put(i,x,y){i.x=Math.max(-15,Math.min(W-i.w+15,x));i.y=Math.max(-15,Math.min(H-i.h+15,y));place(i);checks()}
function pick(i){sel=i;items.forEach(o=>o.el.classList.toggle("sel",o==i));$("#rot").disabled=false;$("#del").disabled=false}
let drag=null;
function down(ev,i){ev.preventDefault();i.el.setPointerCapture(ev.pointerId);drag={px:ev.clientX,py:ev.clientY,x:i.x,y:i.y};i.el.classList.add("drag");pick(i)}
function mv(ev,i){if(!drag||sel!=i)return;put(i,drag.x+(ev.clientX-drag.px)/S,drag.y+(ev.clientY-drag.py)/S)}
function up(ev,i){drag=null;i.el.classList.remove("drag")}
$("#rot").onclick=()=>{if(!sel)return;const i=sel,cx=i.x+i.w/2,cy=i.y+i.h/2;[i.w,i.h]=[i.h,i.w];i.x=cx-i.w/2;i.y=cy-i.h/2;put(i,i.x,i.y)};
$("#rst").onclick=()=>{layout();const old=[...$("#board").children];$("#board").innerHTML="";build()};
addEventListener("resize",()=>{if(!$("#plan").hidden)render()});

const EX=[["Desk pad",80,40],["Speakers",12,12],["Webcam",8,6],["Headphone stand",12,12],["USB hub",10,5],["Wireless charger",10,10],["Desk fan",15,15],["Notebook",21,15],["Mug",9,9],["Plant",12,12],["Router",20,15],["Printer",40,35]];
function spot(w,h){const r=items.filter(i=>i.t!="tray"&&i.t!="pad");for(let y=0;y<=H-h;y+=3)for(let x=0;x<=W-w;x+=3)if(!r.some(i=>x<i.x+i.w&&i.x<x+w&&y<i.y+i.h&&i.y<y+h))return[x,y];return[Math.max(0,(W-w)/2),Math.max(0,(H-h)/2)]}
function addItem(n,w,h){w=Math.max(2,Math.min(+w||10,W));h=Math.max(2,Math.min(+h||10,H));
const pad=/pad/i.test(n)&&w>=40,it=mk("x"+Date.now(),n,pad?"pad":"extra",w,h,0,0);
if(pad){it.x=(W-w)/2;it.y=H-h-1}else{const s=spot(w,h);it.x=s[0];it.y=s[1]}
items.push(it);mkEl(it);if(pad)it.el.classList.add("pad");place(it);checks();pick(it);
requestAnimationFrame(()=>requestAnimationFrame(()=>it.el.classList.remove("pre")))}
$("#add").onclick=()=>{$("#addp").hidden=!$("#addp").hidden};
EX.forEach(e=>{const b=document.createElement("button");b.className="chip";b.innerHTML=e[0]+"<small>"+e[1]+" × "+e[2]+" cm</small>";b.onclick=()=>addItem(e[0],e[1],e[2]);$("#ex").append(b)});
$("#ca").onclick=()=>{const n=$("#cn").value.trim();if(!n){$("#cn").focus();return}addItem(n,$("#cw").value,$("#ch").value);$("#cn").value=""};
$("#del").onclick=()=>{if(!sel)return;sel.el.remove();items=items.filter(i=>i!==sel);sel=null;$("#rot").disabled=true;$("#del").disabled=true;checks()};
function checks(){
const real=items.filter(i=>i.t!="tray"&&i.t!="pad"),mons=items.filter(i=>i.t=="mon"),lamp=items.find(i=>i.t=="lamp"),tray=items.find(i=>i.t=="tray");
const off=real.filter(i=>i.x<-.5||i.y<-.5||i.x+i.w>W+.5||i.y+i.h>H+.5),ov=[];
for(let a=0;a<real.length;a++)for(let b=a+1;b<real.length;b++){const p=real[a],q=real[b];
if(p.x<q.x+q.w&&q.x<p.x+p.w&&p.y<q.y+q.h&&q.y<p.y+p.h)ov.push(p.n+" and "+q.n)}
const dist=mons.length?Math.round(Math.min(...mons.map(m=>H-m.y-4))):99,narrow=W<mons.length*50+24;
const glare=!!lamp&&mons.some(m=>lamp.y+lamp.h/2>m.y+m.h&&lamp.x+lamp.w>m.x-15&&lamp.x<m.x+m.w+15);
const R=[];const P=(ok,g,b)=>R.push([ok,ok?g:b]);
P(!off.length,"Everything sits on the desk",(off[0]||{}).n+" hangs off the desk edge");
P(!ov.length,"Nothing overlaps",ov[0]+" overlap");
P(dist>=50,(mons.length?"Screen distance is comfortable, about "+dist+" cm":"No monitors on the desk to check"),"Screen is about "+dist+" cm from the front edge. Aim for 50 to 70 cm.");
P(!narrow,"The desk is wide enough for your monitors","This desk is tight for "+mons.length+" monitors at full size");
P(!glare,"The lamp stays clear of your screens","The lamp sits in front of a screen and can reflect in it");
P(!tray||tray.y+tray.h/2<H*.5,"Cable tray is at the back","Move the cable tray toward the back edge");
$("#score").textContent=R.filter(r=>r[0]).length+" of "+R.length+" checks passed";
$("#ck").innerHTML=R.map(r=>"<li class='"+(r[0]?"g":"w")+"'><b>"+(r[0]?"✓":"!")+"</b><span>"+r[1]+"</span></li>").join("");
}

function snap(){
const c=document.createElement("canvas"),k=860/W;c.width=900;c.height=Math.round(H*k)+84;const g=c.getContext("2d");
g.fillStyle="#0b1020";g.fillRect(0,0,c.width,c.height);g.fillStyle="#182046";g.fillRect(20,20,W*k,H*k);
const rr=(x,y,w,h)=>{g.beginPath();(g.roundRect||g.rect).call(g,x,y,w,h,8)};
[...items].sort((a,b)=>(a.t=="pad"?-2:a.t=="tray"?-1:0)-(b.t=="pad"?-2:b.t=="tray"?-1:0)).forEach(i=>{
rr(20+i.x*k,20+i.y*k,i.w*k,i.h*k);
if(i.t=="tray"){g.setLineDash([8,6]);g.strokeStyle="#8fa0e8";g.lineWidth=2;g.stroke();g.setLineDash([])}else{g.fillStyle=C[i.t];g.fill()}
g.fillStyle=TXT[i.t]||"#fff";g.font="600 15px sans-serif";g.textAlign="center";g.textBaseline="middle";
g.fillText(i.w*k>(i.n.length*8.5)?i.n:i.n[0],20+(i.x+i.w/2)*k,20+(i.y+i.h/2)*k)});
g.fillStyle="#93a0c6";g.font="500 16px sans-serif";g.textAlign="left";
g.fillText(A.desk+" desk, "+W+" × "+H+" cm",20,H*k+56);g.textAlign="right";g.fillText("thesetupvault.vercel.app",880,H*k+56);
return c.toDataURL("image/png")}

$("#go").onclick=()=>{$("#intro").hidden=true;$("#plan").hidden=false;build();scrollTo(0,0)};
$("#fin").onclick=()=>{
$("#snap").src=snap();
const cab=A.cab<6?"Gather everything into one bundle with hook-and-loop ties and run it along the back edge of the desk.":
A.cab<13?"Mount the cable tray at the back, bundle cables by device, and clip the single run that drops to the floor.":
"Use the tray plus a cable sleeve. Bundle power and data cables separately and label both ends of each.";
$("#tips").innerHTML=["<li>"+cab+"</li>","<li>Keep the tray 5 cm below the desk surface so cables never cross your work area.</li>",
(A.pc=="tower"?"<li>Leave about 10 cm around the tower so its vents stay clear.</li>":"<li>Run the laptop charger through the tray so only one cable shows.</li>")].join("");
$("#chk").innerHTML=["Measure your desk to confirm it’s about "+W+" × "+H+" cm.",
A.mon>1?"Match monitor heights so the tops line up.":"Set the top of the screen at or just below eye level.",
"Keep screens 50 to 70 cm from your eyes.","Put the power strip under the desk, not on top.","Place the lamp beside the screens, not in front of them."].map(t=>"<li>"+t+"</li>").join("");
$("#plan").hidden=true;$("#res").hidden=false;scrollTo(0,0)};
$("#back").onclick=()=>{$("#res").hidden=true;$("#plan").hidden=false;render()};
</script>
	</body>
</html>
