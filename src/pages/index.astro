---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ChecklistCapture from '../components/ChecklistCapture.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { FEATURED_GUIDES, SITE_TITLE } from '../consts';
import { PRODUCTS } from '../data/products';

const allPosts = await getCollection('blog');
const featured = FEATURED_GUIDES.map((id) => allPosts.find((post) => post.id === id)).filter(
	(post) => post !== undefined
);
---

<!doctype html>
<html lang="en">
	<head>
        <meta name="msvalidate.01" content="150552B19FC8B6D3BA6793A45AEC79F2" />
		<BaseHead
			title="The Setup Vault | Desk Setup Guides & Planning Tools"
			description="Practical desk setup guides plus our own cable management guide and workspace planner, so you plan your home office before you buy more gear."
			schema={[
				{
					'@context': 'https://schema.org',
					'@type': 'WebSite',
					name: SITE_TITLE,
					url: 'https://thesetupvault.vercel.app/',
				},
				{
					'@context': 'https://schema.org',
					'@type': 'Organization',
					name: SITE_TITLE,
					url: 'https://thesetupvault.vercel.app/',
					founder: { '@type': 'Person', name: 'Teza Simulunga' },
					sameAs: [
						'https://www.pinterest.com/thesetupvault_/',
						'https://beacons.page/thesetupvault',
					],
				},
			]}
		/>
		<style>
			.paths {
				display: flex;
				flex-direction: column;
				gap: 1.5em;
				margin: 2em 0;
			}
			.path {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 14px;
				padding: 1.5em;
			}
			.path h2 {
				font-size: 1.3em;
				margin-bottom: 0.4em;
			}
			.path p {
				margin-bottom: 0.75em;
			}
			.path a.cta {
				display: inline-block;
				background: var(--accent);
				color: white;
				font-weight: 700;
				text-decoration: none;
				padding: 0.6em 1.4em;
				border-radius: 8px;
				transition: background 0.2s ease;
			}
			.path a.cta:hover {
				background: var(--accent-dark);
				color: white;
			}
			.own-products {
				margin: 2.5em 0;
			}
			.own-products h2 {
				font-size: 1.3em;
				margin-bottom: 0.3em;
			}
			.product-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.5em;
				margin: 1.25em 0 0.75em;
			}
			.product-card {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 14px;
				padding: 1.25em;
				text-align: center;
			}
			.product-card img {
				margin: 0 auto 0.75em;
				display: block;
			}
			.product-card h3 {
				font-size: 1.05em;
				margin: 0 0 0.4em;
			}
			.product-card p {
				margin: 0 0 0.6em;
				font-size: 0.95em;
			}
			.product-card .price {
				font-weight: 700;
				font-size: 1.2em;
			}
			.product-card .price-original {
				text-decoration: line-through;
				color: rgb(var(--gray));
				margin-left: 0.4em;
			}
			.product-card a.cta {
				display: inline-block;
				background: var(--accent);
				color: white;
				font-weight: 700;
				text-decoration: none;
				padding: 0.55em 1.1em;
				border-radius: 8px;
				font-size: 0.9em;
			}
			.all-products {
				text-align: center;
			}
			@media (max-width: 640px) {
				.product-grid {
					grid-template-columns: 1fr;
				}
			}
			.featured {
				margin: 2.5em 0;
			}
			.featured h2 {
				font-size: 1.3em;
				margin-bottom: 0.3em;
			}
			.featured > p {
				margin-bottom: 0.5em;
			}
			.featured ul {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.featured li {
				border-top: 1px solid rgb(var(--gray-light));
				padding: 0.9em 0;
			}
			.featured li:last-child {
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.featured li a {
				font-weight: 700;
				text-decoration: none;
			}
			.featured li a:hover {
				text-decoration: underline;
			}
			.featured li p {
				margin: 0.3em 0 0;
				font-size: 0.95em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Plan a Workspace That Works For You — Before You Spend Another Dollar</h1>
			<p>
				The Setup Vault helps you make better decisions about your home office, not just buy
				more stuff for it. We do that two ways: free guides that answer specific setup
				questions, and our own planning tools for organizing a workspace from the ground up.
			</p>

			<div class="paths">
				<div class="path">
					<h2>Guides</h2>
					<p>
						Practical answers to specific desk-setup questions — cable management, monitor
						and laptop positioning, lighting, organization, and more — so you know what
						actually matters before you buy anything.
					</p>
					<a class="cta" href="/blog">Browse all guides →</a>
				</div>
			</div>

			<section class="own-products">
				<h2>Our guides and planners</h2>
				<p>
					If you're planning or reorganizing your whole workspace rather than fixing one
					thing, our own PDF guides walk you through it end to end.
				</p>
				<div class="product-grid">
					{PRODUCTS.map((p) => (
						<div class="product-card">
							<Image src={p.cover} width={160} height={160} alt={`Cover of ${p.title}`} />
							<h3>{p.title}</h3>
							<p>{p.outcome}</p>
							<p class="price-row">
								<span class="price">{p.price}</span>
								{p.originalPrice && <span class="price-original">{p.originalPrice}</span>}
							</p>
							<a class="cta" href={p.url}>Get the {p.shortTitle.toLowerCase()} →</a>
						</div>
					))}
				</div>
				<p class="all-products"><a href="/products">See both guides in detail →</a></p>
			</section>

			{featured.length > 0 && (
				<section class="featured">
					<h2>Start with these guides</h2>
					<p>Comparisons and how-tos that answer the setup questions people ask most.</p>
					<ul>
						{featured.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								<p>{post.data.description}</p>
							</li>
						))}
					</ul>
				</section>
			)}

			<ChecklistCapture />

			<p>
				Where it's genuinely useful, our guides also point to specific products on Amazon.
				That's supporting monetization, not the reason this site exists — full disclosure is
				on our <a href="/about">About & Affiliate Disclosure page</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>

