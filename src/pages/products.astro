---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_DESCRIPTION } from '../consts';
import DeskGuideCover from '../assets/product-cover-desk-setup-guide.png';
import PlannerCover from '../assets/product-cover-desk-setup-planner.png';
import ChecklistCapture from '../components/ChecklistCapture.astro';

const products = [
	{
		title: 'The Ultimate Desk Setup & Cable Management Guide',
		description:
			'A short, practical PDF guide for getting your cables under control. It walks you through picking the setup profile that matches your desk — Minimalist, Dual-Screen Standard, Power User, or Hybrid Worker — then gives you that profile\'s cable-routing plan and checklist.',
		audience: 'Best for: fixing cable clutter on the desk you already have.',
		price: '$10',
		originalPrice: '$12.50',
		url: '/go/cable-guide/',
		cover: DeskGuideCover,
	},
	{
		title: 'The Complete Desk Setup Planner',
		description:
			'A 34-page planning workbook for figuring out your whole workspace before you buy anything else. Diagnose what\'s not working, measure your space, plan monitor and cable placement, organize what you already have, and work out what\'s actually worth upgrading first.',
		audience: 'Best for: planning or reworking your whole workspace before you spend another dollar.',
		price: '$19',
		url: '/go/desk-planner/',
		cover: PlannerCover,
	},
];
---

<html lang="en">
	<head>
		<BaseHead title={`Products — The Setup Vault`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 820px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.page-heading {
				margin-bottom: 0.3em;
			}
			.page-sub {
				color: rgb(var(--gray));
				margin: 0 0 2em 0;
			}
			.product-list {
				display: flex;
				flex-direction: column;
				gap: 1.25em;
			}
			.product-card {
				display: flex;
				gap: 1.5em;
				align-items: center;
				background: white;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 14px;
				padding: 1.25em;
				box-shadow: 0 2px 6px rgba(var(--gray), 12%);
			}
			.product-thumb {
				flex-shrink: 0;
				width: 110px;
				height: 110px;
				border-radius: 12px;
				overflow: hidden;
			}
			.product-thumb img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.product-info {
				flex: 1;
				min-width: 0;
			}
			.product-info h2 {
				font-size: 1.15em;
				margin: 0 0 0.35em 0;
			}
			.product-info p {
				font-size: 0.7em;
				color: rgb(var(--gray-dark));
				margin: 0;
				line-height: 1.5;
			}
			.product-audience {
				font-size: 0.7em;
				font-weight: 700;
				color: rgb(var(--accent));
				margin: 0.5em 0 0 0;
			}
			.product-side {
				flex-shrink: 0;
				display: flex;
				flex-direction: column;
				align-items: flex-end;
				gap: 0.6em;
			}
			.price-row {
				display: flex;
				align-items: baseline;
				gap: 0.5em;
			}
			.price {
				font-size: 1.3em;
				font-weight: 700;
				color: rgb(var(--black));
			}
			.price-original {
				font-size: 0.85em;
				color: rgb(var(--gray));
				text-decoration: line-through;
			}
			.get-it {
				display: inline-block;
				background: var(--accent);
				color: white;
				font-weight: 700;
				text-decoration: none;
				padding: 0.55em 1.3em;
				border-radius: 8px;
				font-size: 0.85em;
				white-space: nowrap;
				transition: background 0.2s ease;
			}
			.get-it:hover {
				background: var(--accent-dark);
			}
			.buying-guide {
				margin-top: 2.5em;
				padding: 1.5em 1.75em;
				border: 1px dashed rgb(var(--gray-light));
				border-radius: 14px;
				color: rgb(var(--gray-dark));
				font-size: 0.85em;
			}
			.buying-guide strong {
				display: block;
				margin-bottom: 0.6em;
				color: rgb(var(--black));
				font-size: 1.05em;
			}
			.buying-guide ul {
				margin: 0;
				padding-left: 1.2em;
			}
			.buying-guide li {
				margin-bottom: 0.4em;
				line-height: 1.5;
			}
			.buying-guide li:last-child {
				margin-bottom: 0;
			}
			@media (max-width: 640px) {
				.product-card {
					flex-wrap: wrap;
				}
				.product-side {
					width: 100%;
					flex-direction: row;
					justify-content: space-between;
					align-items: center;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-heading">Products</h1>
			<p class="page-sub">Guides made by The Setup Vault — no affiliate links, just our own work.</p>

			<div class="product-list">
				{
					products.map((p) => (
						<div class="product-card">
							<div class="product-thumb">
								<Image src={p.cover} width={220} height={220} alt="" />
							</div>
							<div class="product-info">
								<h2>{p.title}</h2>
								<p>{p.description}</p>
								<p class="product-audience">{p.audience}</p>
							</div>
							<div class="product-side">
								<div class="price-row">
									<span class="price">{p.price}</span>
									{p.originalPrice && <span class="price-original">{p.originalPrice}</span>}
								</div>
								<a class="get-it" href={p.url} target="_blank" rel="noopener">
									Get it
								</a>
							</div>
						</div>
					))
				}
			</div>

			<div class="buying-guide">
				<strong>Not sure which one?</strong>
				<ul>
					<li>Need to fix cable clutter on the desk you already have → the Cable Management Guide.</li>
					<li>Planning or reworking the whole workspace before you buy anything else → the Desk Setup Planner.</li>
					<li>Doing both → each one solves a different part of the problem, so use whichever matches what you're working on right now.</li>
				</ul>
			</div>

			<ChecklistCapture />
		</main>
		<Footer />
	</body>
</html>
