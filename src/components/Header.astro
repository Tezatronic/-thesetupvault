---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/products">Products</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://www.pinterest.com/thesetupvault_/" target="_blank" rel="noopener">Pinterest</a>
			<a href="https://www.instagram.com/the.setup.vault/" target="_blank" rel="noopener">Instagram</a>
			<a href="https://www.tiktok.com/@the.setup.vault" target="_blank" rel="noopener">TikTok</a>
			<a href="https://whop.com/the-setup-vault/products" target="_blank" rel="noopener">Whop Store</a>
			<a href="https://beacons.page/thesetupvault" target="_blank" rel="noopener">Beacons</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links {
		display: flex;
		gap: 0.9em;
		font-weight: 600;
		font-size: 0.9em;
		text-decoration: underline;
	}
	@media (max-width: 1000px) {
		.social-links {
			display: none;
		}
	}
</style>
