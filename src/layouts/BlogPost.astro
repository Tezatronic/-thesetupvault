---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { productForSlug } from '../data/products';

type Props = CollectionEntry<'blog'>['data'] & {
	slug?: string;
	hasProductCta?: boolean;
	topic?: { key: string; label: string };
	related?: { title: string; url: string }[];
};

const { title, description, pubDate, updatedDate, heroImage, slug, hasProductCta, topic, related = [] } = Astro.props;

// Article markup only for real guides under /blog/ (the About page also uses this layout).
const isGuide = Astro.url.pathname.startsWith('/blog/');
const site = 'https://thesetupvault.vercel.app';
const pageUrl = new URL(Astro.url.pathname, site).href;
const publisher = { '@type': 'Organization', name: 'The Setup Vault', url: `${site}/` };
const author = { '@type': 'Person', name: 'Teza Simulunga', url: `${site}/about/` };
const schema = isGuide
	? [
			{
				'@context': 'https://schema.org',
				'@type': 'Article',
				headline: title,
				description,
				datePublished: pubDate.toISOString(),
				dateModified: (updatedDate ?? pubDate).toISOString(),
				author,
				publisher,
				image: `${site}/og-default.png`,
				mainEntityOfPage: pageUrl,
			},
			{
				'@context': 'https://schema.org',
				'@type': 'BreadcrumbList',
				itemListElement: [
					{ '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
					{ '@type': 'ListItem', position: 2, name: 'Guides', item: `${site}/blog/` },
					{ '@type': 'ListItem', position: 3, name: title, item: pageUrl },
				],
			},
		]
	: undefined;

// One matching owned-product block per guide, unless the guide already links to one.
const ownProduct = isGuide && slug && !hasProductCta ? productForSlug(slug) : undefined;
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			ogType={isGuide ? 'article' : 'website'}
			schema={schema}
		/>
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.byline {
				margin: 0.25em 0 0;
				font-size: 0.95em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.related {
				margin: 2em 0;
			}
			.related h3 {
				margin: 0 0 0.5em;
				font-size: 1.1em;
			}
			.related ul {
				margin: 0;
				padding-left: 1.2em;
			}
			.related li {
				margin-bottom: 0.4em;
				line-height: 1.4;
			}
			.own-product {
				margin: 2em 0;
				padding: 1.1em 1.25em;
				border: 1px solid rgb(var(--gray-light));
				border-left: 4px solid var(--accent);
				border-radius: 10px;
			}
			.own-product h3 {
				margin: 0 0 0.35em;
				font-size: 1.1em;
			}
			.own-product p {
				margin: 0 0 0.75em;
				font-size: 0.95em;
			}
			.own-product a {
				display: inline-block;
				background: var(--accent);
				color: white;
				font-weight: 700;
				text-decoration: none;
				padding: 0.5em 1.1em;
				border-radius: 8px;
				font-size: 0.9em;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{
							isGuide && (
								<p class="byline">
									By <a href="/about">Teza Simulunga</a>
									{topic && (
										<>
											{' · '}
											<a href={`/blog/topic/${topic.key}/`}>{topic.label}</a>
										</>
									)}
								</p>
							)
						}
					<hr />
				</div>
				<slot />
				{ownProduct && (
					<aside class="own-product">
						<h3>{ownProduct.title}</h3>
						<p>{ownProduct.outcome} {ownProduct.price} PDF.</p>
						<a href={ownProduct.url}>See the {ownProduct.shortTitle.toLowerCase()} →</a>
					</aside>
				)}
				{isGuide && related.length > 0 && (
					<nav class="related" aria-label="Related guides">
						<h3>Related guides</h3>
						<ul>
							{related.map((r) => <li><a href={r.url}>{r.title}</a></li>)}
						</ul>
					</nav>
				)}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
